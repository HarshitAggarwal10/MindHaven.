# Copy to .env for local development. Never commit real credentials.
SECRET_KEY=replace-with-a-long-random-django-secret
DEBUG=True
USE_SQLITE=true
FERNET_KEY=replace-with-a-generated-fernet-key
JWT_SECRET=replace-with-a-long-random-jwt-secret

# CPU-only local inference (no per-request hosted inference charges).
MOOD_AI_PROVIDER=local-transformers
MOOD_AI_MODEL_ID=j-hartmann/emotion-english-distilroberta-base
MOOD_AI_MODEL_VERSION=
MOOD_AI_TIMEOUT_SECONDS=15
MOOD_AI_LOCAL_FILES_ONLY=false
MOOD_AI_LOCAL_CACHE_DIR=
MOOD_AI_LOCAL_NUM_THREADS=2

# Optional Razorpay test-mode credentials. Keep these server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional hosted inference instead: set MOOD_AI_PROVIDER=hf-inference and
# provide HUGGINGFACE_API_TOKEN privately in this backend .env only.
# Hugging Face hosted inference may require billable credits.
